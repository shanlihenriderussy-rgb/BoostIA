# --- Configuration BoostIA -------------------------------------------------
# Copier ce fichier en `.env` et adapter au besoin.
# Toutes les variables sont optionnelles : les valeurs par défaut conviennent
# pour un usage local.

# URL d'Ollama (laisser tel quel pour un Ollama local)
OLLAMA_BASE_URL=http://localhost:11434

# Modèle utilisé. Pour la 3050 Ti (4 Go VRAM) : qwen2.5:3b-instruct conseillé.
# Alternatives :
#   - llama3.2:3b-instruct        (meta, bon FR)
#   - phi3.5:3.8b-mini-instruct   (microsoft, plus court)
#   - qwen2.5:7b-instruct         (meilleure qualité, offload partiel CPU)
MODEL_NAME=qwen2.5:3b-instruct

# Timeout (en secondes) pour un appel Ollama complet
REQUEST_TIMEOUT_SECONDS=120

# Paramètres de génération
DEFAULT_TEMPERATURE=0.4
DEFAULT_TOP_P=0.9

# Niveau de log : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# CORS : laissé vide par défaut (UI servie par FastAPI = même origine).
# Pour autoriser une UI servie ailleurs, mettre une liste JSON, ex :
# CORS_ORIGINS=["http://localhost:3000","https://mon-domaine.example"]
CORS_ORIGINS=[]
